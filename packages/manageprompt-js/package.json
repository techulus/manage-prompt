{
  "name": "manageprompt",
  "version": "0.5.0",
  "description": "Local LLM call debugger — capture, log, and inspect any AI API call",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "test:openai": "tsx tests/test-openai.ts",
    "test:anthropic": "tsx tests/test-anthropic.ts",
    "test:openrouter": "tsx tests/test-openrouter.ts",
    "test:streaming-tools": "tsx tests/test-streaming-tools.ts",
    "test:capture-openai": "tsx tests/test-capture-openai.ts",
    "test:capture-anthropic": "tsx tests/test-capture-anthropic.ts"
  },
  "peerDependencies": {
    "@ai-sdk/provider": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@ai-sdk/anthropic": "^3.0.46",
    "@ai-sdk/openai": "^3.0.30",
    "@ai-sdk/provider": "^3.0.8",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@rollup/plugin-typescript": "^12.1.0",
    "openai": "^4.80.0",
    "ai": "^6.0.97",
    "rollup": "^4.30.0",
    "rollup-plugin-dts": "^6.2.0",
    "tslib": "^2.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "zod": "^4.3.6"
  },
  "keywords": [
    "ai",
    "llm",
    "debugging",
    "openai",
    "anthropic",
    "vercel-ai-sdk",
    "middleware",
    "capture",
    "logging"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/techulus/manage-prompt"
  }
}
